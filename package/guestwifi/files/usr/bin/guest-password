#!/bin/sh

# Deterministic guest Wi-Fi password generator.
#
# Usage:
#   ./guest-password.sh <shared-secret> [YYYY-MM-DD]
#
# Example:
#   ./guest-password.sh "my-secret-key"
#   ./guest-password.sh "my-secret-key" 2026-09-17
#
# The same date + secret always produces the same password.

set -eu

CONFIG="guestwifi.main"
ENABLED="$(uci -q get ${CONFIG}.enabled || true)"
SSID="$(uci -q get ${CONFIG}.ssid || true)"
SECRET="$(uci -q get ${CONFIG}.secret || true)"

if [ "$ENABLED" != "1" ]; then
  exit 0
fi

if [ -z "$SSID" ]; then
  echo "guestwifi: SSID is not configured" >&2
  exit 1
fi

if [ -z "$SECRET" ]; then
  echo "guestwifi: shared secret is not configured" >&2
  exit 1
fi

DATE="${2:-$(date +%F)}"
QR=0
PNG=""

MESSAGE="guestwifi-v1|${DATE}"

# Calculate HMAC-SHA256.
HASH=$(printf '%s' "$MESSAGE" |
  openssl dgst -sha256 -hmac "$SECRET" |
  awk '{print $NF}')

# Exactly 256 unique words.
WORDS="
amber
apple
apricot
arrow
aspen
atlas
autumn
badger
bamboo
banner
barley
beacon
berry
birch
blossom
blue
breeze
bridge
brook
butter
cactus
candle
canyon
cedar
cherry
circle
cliff
clover
cloud
cobalt
comet
coral
cotton
cricket
crystal
daisy
dawn
delta
desert
dove
dragon
dream
drift
eagle
earth
echo
elm
ember
falcon
fern
field
finch
flame
flint
flower
forest
fox
frost
garden
garlic
gentle
glade
gold
grape
grass
green
grove
harbor
hawk
hazel
heather
hill
honey
horizon
ice
iris
island
jade
jasmine
jewel
juniper
kettle
kiwi
knight
lake
lantern
lavender
leaf
lemon
lilac
lime
linen
maple
marble
marsh
meadow
melon
mercury
mesa
metal
meteor
midnight
mint
mist
moon
moss
mountain
mouse
nectar
night
north
nova
oak
oasis
ocean
olive
orchid
otter
panda
paper
peach
pearl
pebble
pepper
petal
phoenix
pine
planet
plum
polar
pond
prairie
prism
pumpkin
quartz
rabbit
rain
rainbow
raven
red
reef
river
robin
rocket
rose
ruby
sable
sage
salmon
sand
saturn
scarlet
sea
shadow
shell
silver
sky
snow
sparrow
spice
spider
spring
spruce
star
stone
storm
stream
summer
sun
sunset
swift
tango
teal
thistle
thunder
tiger
topaz
trail
tree
tulip
turtle
valley
velvet
violet
walnut
water
wave
whale
wheat
willow
wind
winter
wolf
wood
yellow
zebra
acorn
anchor
angel
apron
badge
basket
beaver
bell
boat
bolt
branch
brick
cabin
camel
cello
chain
cheese
chisel
clay
copper
crown
drum
feather
fiddle
flute
hammer
harp
helmet
isle
jacket
jigsaw
koi
ladder
leopard
magnet
map
market
mirror
napkin
nest
nettle
paddle
parrot
peacock
pencil
pigeon
pocket
pony
ribbon
saddle
sail
scooter
seal
shark
shelter
skate
spoon
square
squirrel
stamp
swan
sword
tent
thimble
ticket
tower
train
trumpet
wagon
whistle
"

# Use a custom word list from UCI if valid, otherwise the built-in list.
CUSTOM_WORDS="$(uci -q get ${CONFIG}.words || true)"

WORD_LIST=$(printf '%s\n' "$WORDS" | sed '/^$/d')

if [ -n "$CUSTOM_WORDS" ]; then
  CUSTOM_LIST=$(printf '%s' "$CUSTOM_WORDS" |
    sed 's/^[[:space:]]*//;s/[[:space:]]*$//;/^$/d')

  CUSTOM_COUNT=$(printf '%s\n' "$CUSTOM_LIST" | wc -l)
  CUSTOM_BAD=$(printf '%s\n' "$CUSTOM_LIST" | grep -cvE '^[a-z]{3,12}$' || true)
  CUSTOM_DUP=$(printf '%s\n' "$CUSTOM_LIST" | sort | uniq -d)

  if [ "$CUSTOM_COUNT" -eq 256 ] && [ "$CUSTOM_BAD" -eq 0 ] && [ -z "$CUSTOM_DUP" ]; then
    WORD_LIST=$CUSTOM_LIST
  else
    echo "guestwifi: invalid custom word list (need exactly 256 unique lowercase words, 3-12 chars); using built-in list" >&2
  fi
fi

byte() {
  OFFSET="$1"
  START=$((OFFSET * 2 + 1))
  END=$((START + 1))

  HEX=$(printf '%s' "$HASH" | cut -c "${START}-${END}")
  printf '%d' "0x${HEX}"
}

word() {
  INDEX="$1"
  printf '%s\n' "$WORD_LIST" |
    sed -n "$((INDEX + 1))p"
}

W1=$(word "$(byte 0)")
D1=$(($(byte 1) % 10))

W2=$(word "$(byte 2)")
D2=$(($(byte 3) % 10))

W3=$(word "$(byte 4)")
D3=$(($(byte 5) % 10))

W4=$(word "$(byte 6)")
D4=$(($(byte 7) % 10))

cap() {
  if command -v awk >/dev/null 2>&1; then
    printf '%s' "$1" | awk '{print toupper(substr($0,1,1)) substr($0,2)}'
  else
    printf '%s' "$1" | sed 's/./\u&/'
  fi
}

W1=$(cap "$W1")
W2=$(cap "$W2")
W3=$(cap "$W3")
W4=$(cap "$W4")

PASSWORD=$(printf '%s%s-%s%s-%s%s-%s%s' \
  "$W1" "$D1" \
  "$W2" "$D2" \
  "$W3" "$D3" \
  "$W4" "$D4")

echo "$PASSWORD"

WEB_DIR="/www/guestwifi"
mkdir -p "$WEB_DIR"

# Apply the generated password to matching guest wireless interfaces.
INTERFACE="$(uci -q get ${CONFIG}.interface || true)"
WIFI_APPLIED=0
MATCHED=0

apply_iface() {
  SID="$1"
  MATCHED=1
  [ "$(uci -q get "wireless.${SID}.key" || true)" = "$PASSWORD" ] || {
    uci set "wireless.${SID}.key"="$PASSWORD"
    WIFI_APPLIED=1
  }
}

if [ -n "$INTERFACE" ]; then
  if [ -n "$(uci -q get "wireless.${INTERFACE}.ssid" || true)" ]; then
    apply_iface "$INTERFACE"
  else
    echo "guestwifi: wireless interface '${INTERFACE}' not found; key not applied" >&2
  fi
else
  IFACES=$(uci show wireless 2>/dev/null |
    grep -oE 'wireless\.[^.]+\.ssid' | cut -d. -f2 | sort -u)
  for SID in $IFACES; do
    S_SSID=$(uci -q get "wireless.${SID}.ssid" || true)
    S_MODE=$(uci -q get "wireless.${SID}.mode" || true)
    if [ "$S_SSID" = "$SSID" ] && { [ -z "$S_MODE" ] || [ "$S_MODE" = "ap" ]; }; then
      apply_iface "$SID"
    fi
  done
  [ "$MATCHED" = "1" ] || echo "guestwifi: no wifi-iface matches SSID '${SSID}'; key not applied" >&2
fi

# Idempotent early exit: page + QR + AP key already reflect current secret/date.
STATE_CUR="$(cat "${WEB_DIR}/.state" 2>/dev/null || true)"
if [ "$WIFI_APPLIED" = "0" ] && \
   [ -f "${WEB_DIR}/guest.svg" ] && \
   [ -f "${WEB_DIR}/index.html" ] && \
   [ "$STATE_CUR" = "${PASSWORD}|${DATE}" ]; then
  exit 0
fi

# Escape characters required by the Wi-Fi QR format.
qr_escape() {
  printf '%s' "$1" |
    sed 's/\\/\\\\/g; s/;/\\;/g; s/,/\\,/g; s/:/\\:/g'
}

QR_SSID="$(qr_escape "$SSID")"
QR_PASSWORD="$(qr_escape "$PASSWORD")"

WIFI_QR="WIFI:T:WPA;S:${QR_SSID};P:${QR_PASSWORD};;"

qrencode -t SVG -o "${WEB_DIR}/guest.svg" "${WIFI_QR}"

cat >"${WEB_DIR}/index.html" <<EOF
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Guest Wi-Fi</title>
<style>
body {
	font-family: sans-serif;
	max-width: 500px;
	margin: 2rem auto;
	padding: 0 1rem;
	text-align: center;
}
img {
	max-width: 100%;
	image-rendering: pixelated;
}
.label {
	color: #666;
	margin-top: 1.5rem;
}
.value {
	font-size: 1.4rem;
	font-weight: bold;
	word-break: break-word;
}
.refresh {
	color: #999;
	font-size: 0.85rem;
	margin-top: 2rem;
}
</style>
</head>
<body>
<h1>Guest Wi-Fi</h1>

<div class="label">Network</div>
<div class="value">$(printf '%s' "$SSID" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g')</div>

<p>
<img src="guest.svg" alt="Guest Wi-Fi QR code">
</p>

<div class="label">Password</div>
<div class="value">$PASSWORD</div>

<div class="label">Date</div>
<div class="value">$DATE</div>

<div class="refresh">Auto-reloads in <span id="count">300</span>s</div>

<script>
(function () {
	var seconds = 300;
	var el = document.getElementById("count");
	var t = setInterval(function () {
		seconds -= 1;
		el.textContent = seconds;
		if (seconds <= 0) {
			clearInterval(t);
			location.reload();
		}
	}, 1000);
})();
</script>
</body>
</html>
EOF

chmod 644 "${WEB_DIR}/guest.svg" "${WEB_DIR}/index.html"
printf '%s|%s\n' "$PASSWORD" "$DATE" > "${WEB_DIR}/.state"

if [ "$WIFI_APPLIED" = "1" ]; then
  uci -q commit wireless
  wifi reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1 || true
fi
