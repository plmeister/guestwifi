#!/bin/sh /etc/rc.common

START=95

CRON_LINE="5 0 * * * /usr/bin/guest-password # guestwifi"

start() {
  [ "$(uci -q get guestwifi.main.enabled)" = "1" ] || return 0

  /usr/bin/guest-password

  mkdir -p /etc/crontabs
  grep -Fq '# guestwifi' /etc/crontabs/root 2>/dev/null ||
    echo "$CRON_LINE" >>/etc/crontabs/root

  /etc/init.d/cron restart 2>/dev/null || true
}

stop() {
  if [ -f /etc/crontabs/root ]; then
    sed -i '/# guestwifi$/d' /etc/crontabs/root
    /etc/init.d/cron restart 2>/dev/null || true
  fi
}
